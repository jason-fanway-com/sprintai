+  // [{open,close}] AND the post-061 flat-object shape {closed,open,close}.
+  // Returns a clean Array<{open,close}> for downstream code that expects
+  // .length and .map.
+  function normalizeHours(dayHours: unknown): Array<{ open: string; close: string }> {
+    if (!dayHours) return [];
