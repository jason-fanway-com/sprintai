# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# public-tester edge function: salts the client IP before hashing it. Never
# log or store the raw IP — only sha256(ip + this salt). Any long random string.
PUBLIC_TESTER_SALT=change_me_to_a_long_random_string

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+16103792553

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Toast POS (per-tenant — stored in integrations table)
# These are not global env vars — stored in integrations.config JSONB
# TOAST_CLIENT_ID=...
# TOAST_CLIENT_SECRET=...

# Netlify (admin dashboard)
# Set in Netlify dashboard:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
